
# Maven build output
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties

# Application configuration containing secrets
src/main/resources/application.properties
src/test/resources/application-test.properties
application-local.properties
application-prod.properties

# Allow safe example configuration files
!src/main/resources/application.example.properties
!src/test/resources/application-test.example.properties

# Environment variables and secrets
.env
.env.*
!.env.example

# Database backups and dumps
*.dump
*.backup
*.bak
*.sql

# Java compiled files and archives
*.class
*.jar
*.war
*.ear

# Eclipse IDE
.metadata/
.settings/
.project
.classpath
bin/

# IntelliJ IDEA
.idea/
*.iml

# Visual Studio Code
.vscode/

